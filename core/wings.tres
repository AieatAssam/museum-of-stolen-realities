rule = "Lightwalking"
palette = PackedColorArray(0.1137, 0.2471, 0.6588, 1, 0.7020, 0.1255, 0.2275, 1, 0.9098, 0.6902, 0.2902, 1)
scene_path = "res://wings/glass/glass.tscn"
