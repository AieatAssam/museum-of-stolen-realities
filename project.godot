[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"
3d_physics/layer_4="trigger"
3d_physics/layer_5="wing_solid"
3d_physics/layer_6="pickup"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=3
environment/defaults/default_clear_color=Color(0.02, 0.018, 0.015, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
environment/screen_space_reflection/roughness_quality=2
textures/vram_compression/import_etc2_astc=true
